{
  "name": "LWK Viewer",
  "short_name": "LWK Viewer",
  "description": "Sheets, 3D model and issues - also without a connection, for a project downloaded to this device.",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f4f7",
  "theme_color": "#f28022",
  "share_target": {
    "action": "share-in",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/pdf", "text/plain", "application/zip", "*/*"] }] }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
