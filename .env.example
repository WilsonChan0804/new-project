# Alpha Vantage: fundamentals + news only (prices come from Stooq)
ALPHA_VANTAGE_API_KEY=your_key_here

# FRED — free key, enables the macro layer (rates, curve, credit, VIX, dollar).
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, macro reports "unavailable" and market regime stays price-only.
FRED_API_KEY=

# EODHD — optional, and the only paid provider supported. Buy it only for
# historical index membership + delisted price history (the survivorship fix).
# Do NOT buy it for fundamentals: SEC EDGAR already gives those point-in-time
# and free. Probe a free key first: python scripts/check_eodhd.py
EODHD_API_KEY=

# SEC EDGAR needs a contactable User-Agent. No key required.
# This powers point-in-time fundamentals — put a real email here.
SEC_USER_AGENT=InvestmentDecisionEngine/1.5 you@example.com

# Price sources, tried in order. Run GET /api/v1/providers/prices to see
# which ones your network can actually reach, then reorder this.
#   yahoo         - adjusted, no key, full history  (recommended primary)
#   stooq         - adjusted, no key, blocks some networks
#   alpha_vantage - UNADJUSTED, uses your daily quota  (last resort)
PRICE_SOURCES=yahoo

# Storage
DB_PATH=engine.db

# Local historical price store. Built by scripts/build_warehouse.py and read
# automatically by backtests, which is what makes wide/long research affordable.
WAREHOUSE_PATH=warehouse.db
USE_WAREHOUSE=true
CACHE_DIR=.cache

# Economics -- change these to match your actual broker and currency
BASE_CURRENCY=GBP
QUOTE_CURRENCY=USD
ROUNDTRIP_COST_BPS=25
FX_COST_BPS=50
ANNUAL_FX_VOL=0.09

# Decision policy
MIN_COVERAGE=0.60
MIN_CONFIDENCE_FOR_ACTION=55

# Components that must be present before any directional action, regardless of
# overall coverage. Valuation is listed because it is the only component the
# 63-name backtest found informative (+0.078, t=+3.09). Change this when the
# attribution table changes, not before. Empty string disables the gate.
CRITICAL_COMPONENTS=valuation
DEFAULT_HORIZON_DAYS=63

# How hard the composite score is allowed to move scenario probabilities away
# from an uninformative 1/3 prior. Set to 0 until the calibration report earns it.
SCORE_TILT_STRENGTH=0.15
