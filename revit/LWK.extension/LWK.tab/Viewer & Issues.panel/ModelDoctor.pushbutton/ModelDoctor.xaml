<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LWK Model Doctor"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        ShowInTaskbar="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1F2933"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7480"/>
    <SolidColorBrush x:Key="Line" Color="#DDE1E6"/>
    <SolidColorBrush x:Key="Accent" Color="#0B6E99"/>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinWidth" Value="86"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0B6E99"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0B6E99"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================= HEADER / HEALTH ================= -->
    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- score badge -->
        <Border Grid.Column="0" x:Name="score_badge" Width="86" Height="86"
                CornerRadius="43" Background="#9AA5B1" Margin="0,0,16,0">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="score_grade" Text="-" FontSize="30"
                       FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="score_value" Text="not run" FontSize="11"
                       Foreground="White" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="model_name" Text="Model Doctor"
                     FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="health_label" Text="Run the checks to score this model."
                     FontSize="12" Foreground="{StaticResource Muted}"
                     Margin="0,3,0,0"/>
          <ProgressBar x:Name="health_bar" Height="6" Maximum="100" Value="0"
                       Margin="0,9,24,0" Foreground="#9AA5B1"
                       Background="#EDEFF2" BorderThickness="0"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button x:Name="btn_run" Content="Run checks" Style="{StaticResource Primary}"
                  MinWidth="120" Padding="14,8"/>
          <Button x:Name="btn_queue" Content="Fix queue" MinWidth="96"
                  ToolTip="Findings the LWK Viewer asked Revit to fix (3D &gt; Checks &gt; Doctor &gt; Fix in Revit)"/>
          <Button x:Name="btn_export" Content="Export CSV"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= BODY ================= -->
    <Grid Grid.Row="1" Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- checks list -->
      <Border Grid.Column="0" Background="White"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="12,10" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <TextBlock Text="CHECKS" Style="{StaticResource Section}"
                         Margin="0" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_all" Content="All" MinWidth="40" Padding="8,2"
                        FontSize="11"/>
                <Button x:Name="btn_none" Content="None" MinWidth="46" Padding="8,2"
                        FontSize="11" Margin="0"/>
              </StackPanel>
            </Grid>
          </Border>

          <ListBox x:Name="check_list" Grid.Row="1" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                            VerticalAlignment="Top" Margin="0,2,8,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="13"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="#6B7480" TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="#0B6E99" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="2" CornerRadius="9"
                          Background="{Binding BadgeBrush}" Padding="8,1"
                          Height="18" VerticalAlignment="Top" MinWidth="26">
                    <TextBlock Text="{Binding CountText}" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" Padding="12,10" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,1,0,0" Background="#FAFBFC">
            <StackPanel>
              <TextBlock Text="SETTINGS FOR SELECTED CHECK"
                         Style="{StaticResource Section}"/>
              <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="settings_panel"/>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    Background="Transparent"/>

      <!-- results -->
      <Border Grid.Column="2" Background="White"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1">
            <StackPanel>
              <TextBlock x:Name="results_title" Text="RESULTS"
                         Style="{StaticResource Section}" Margin="0,0,0,6"/>
              <WrapPanel>
                <TextBlock Text="Check" FontSize="11" Foreground="#6B7480"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="check_filter" Width="150" FontSize="11"
                          Margin="0,0,12,4"/>
                <TextBlock Text="Problem" FontSize="11" Foreground="#6B7480"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="problem_filter" Width="170" FontSize="11"
                          Margin="0,0,12,4"/>
                <TextBlock Text="Severity" FontSize="11" Foreground="#6B7480"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="severity_filter" Width="130" FontSize="11"
                          SelectedIndex="0" Margin="0,0,12,4">
                  <ComboBoxItem Content="All severities"/>
                  <ComboBoxItem Content="Critical only"/>
                  <ComboBoxItem Content="Critical + Warning"/>
                </ComboBox>
                <TextBlock Text="Accepted" FontSize="11" Foreground="#6B7480"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="accepted_filter" Width="140" FontSize="11"
                          SelectedIndex="0" Margin="0,0,0,4">
                  <ComboBoxItem Content="Hide accepted"/>
                  <ComboBoxItem Content="Show all"/>
                  <ComboBoxItem Content="Only accepted"/>
                </ComboBox>
              </WrapPanel>
            </StackPanel>
          </Border>

          <DataGrid x:Name="results_grid" Grid.Row="1" AutoGenerateColumns="False"
                    IsReadOnly="False" HeadersVisibility="Column"
                    CanUserAddRows="False" CanUserDeleteRows="False"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#EDEFF2"
                    RowBackground="White" AlternatingRowBackground="#FAFBFC"
                    BorderThickness="0" FontSize="12" FontFamily="Segoe UI"
                    SelectionMode="Extended" SelectionUnit="FullRow"
                    RowHeight="26">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Accepted}" Value="True">
                    <Setter Property="Background" Value="#E3F0E6"/>
                    <Setter Property="Foreground" Value="#7A8590"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Not an error" Width="76"
                                      SortMemberPath="Accepted">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Accepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ToolTip="Tick to accept this finding. It stays in the list but is excluded from the score, and is remembered next time."/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}"
                                  Width="66" IsReadOnly="True"/>
              <DataGridTextColumn Header="Problem type" Binding="{Binding Problem}"
                                  Width="150" IsReadOnly="True"/>
              <DataGridTextColumn Header="Element ID(s)" Binding="{Binding IdText}"
                                  Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}"
                                  Width="90" IsReadOnly="True"/>
              <DataGridTextColumn Header="Type" Binding="{Binding TypeName}"
                                  Width="130" IsReadOnly="True"/>
              <DataGridTextColumn Header="Level" Binding="{Binding LevelName}"
                                  Width="70" IsReadOnly="True"/>
              <DataGridTextColumn Header="mm" Binding="{Binding ValueText}"
                                  Width="64" IsReadOnly="True"/>
              <DataGridTextColumn Header="Issue" Binding="{Binding Description}"
                                  Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>

          <Border Grid.Row="2" Padding="12,10" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,1,0,0" Background="#FAFBFC">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="btn_copy" Content="Copy IDs"/>
              <Button x:Name="btn_select" Content="Select in model"/>
              <Button x:Name="btn_zoom" Content="Zoom to"/>
              <Border Width="10"/>
              <Button x:Name="btn_accept" Content="Mark not an error"
                      MinWidth="130"
                      ToolTip="Tick every selected row. Shift-click or Ctrl-click to select a range first."/>
              <Button x:Name="btn_reopen" Content="Reopen" MinWidth="70"
                      ToolTip="Untick every selected row."/>
              <Border Width="10"/>
              <CheckBox x:Name="follow_selection" Content="Follow selection"
                        IsChecked="True" FontSize="11" VerticalAlignment="Center"
                        Margin="4,0,10,0"
                        ToolTip="Selecting a row selects it in Revit. Double-click a row to zoom to it."/>
              <Border Width="12"/>
              <Button x:Name="btn_fix" Content="Fix selected"
                      Style="{StaticResource Primary}" MinWidth="130"/>
              <Button x:Name="btn_fix_all" Content="Fix all in this check"
                      MinWidth="150"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= STATUS ================= -->
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="16,7">
      <Grid>
        <TextBlock x:Name="status_text" Text="Ready." FontSize="11"
                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <TextBlock x:Name="version_text" Text="" FontSize="11"
                   Foreground="#9AA5B1" HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
